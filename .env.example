# Clerk — the same Clerk instance as the backend and tenant app (dashboard.clerk.com → API keys).
# See the backend repo's docs/clerk-setup.md for the instance settings this app expects.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Backend platform API. Called server-side only, with the signed-in user's session token.
PLATFORM_API_URL=http://localhost:5000/api/platform
